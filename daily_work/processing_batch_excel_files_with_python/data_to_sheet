import os
import glob
import calendar
from datetime import date
import openpyxl

def daily_report_data_update():
    base_folder = r"C:\Users\hy\Desktop\ZJHY\每日报表\2025年"
    template_file = r"C:\Users\hy\Desktop\ZJHY\每日报表\2025年\4月\ZJHY资产管理2025年4月30日报表_v202603.xlsx"
    year = 2025

    # 检查模板文件是否存在
    if not os.path.exists(template_file):
        print(f"错误：模板文件 '{template_file}' 未找到，请确保它在当前目录下。")
        return

    # 循环处理1月至12月
    for month in range(4, 13):
        month_folder = os.path.join(base_folder, f"{month}月")
        if not os.path.isdir(month_folder):
            print(f"警告：文件夹 '{month_folder}' 不存在，跳过。")
            continue

        # 查找该月份文件夹下的第一个.xlsx文件（假设只有一个）
        excel_files = glob.glob(os.path.join(month_folder, "*.xlsx"))
        if not excel_files:
            print(f"警告：在 '{month_folder}' 中未找到Excel文件，跳过。")
            continue
        source_file = excel_files[0]  # 取第一个
        print(f"正在处理：{month_folder}，源文件：{os.path.basename(source_file)}")

        # 加载源工作簿（只读数据，不读取公式）
        try:
            src_wb = openpyxl.load_workbook(source_file, data_only=True)
        except Exception as e:
            print(f"  无法打开源文件 {source_file}：{e}，跳过。")
            continue

        # 检查所需的Sheet是否存在
        required_src_sheets = ["数据源-还款统计报表", "数据源-逾期报表"]
        if not all(sheet in src_wb.sheetnames for sheet in required_src_sheets):
            print(f"  源文件中缺少所需的Sheet（{required_src_sheets}），跳过。")
            src_wb.close()
            continue

        # 加载模板工作簿
        try:
            tpl_wb = openpyxl.load_workbook(template_file)
        except Exception as e:
            print(f"  无法打开模板文件 {template_file}：{e}，终止处理。")
            return

        # 检查模板中的Sheet
        required_tpl_sheets = ["数据源_还款表", "数据源_逾期表", "数据总表"]
        if not all(sheet in tpl_wb.sheetnames for sheet in required_tpl_sheets):
            print(f"  模板文件中缺少所需的Sheet（{required_tpl_sheets}），终止处理。")
            tpl_wb.close()
            return

        # ---------- 处理“数据源_还款表” ----------
        tpl_sheet_repay = tpl_wb["数据源_还款表"]
        # 清除除表头外的所有行
        max_row = tpl_sheet_repay.max_row
        if max_row > 1:
            tpl_sheet_repay.delete_rows(2, max_row - 1)

        # 从源Sheet读取数据（跳过表头行）
        src_sheet_repay = src_wb["数据源-还款统计报表"]
        for row in src_sheet_repay.iter_rows(min_row=2, values_only=True):
            tpl_sheet_repay.append(row)

        # ---------- 处理“数据源_逾期表” ----------
        tpl_sheet_overdue = tpl_wb["数据源_逾期表"]
        max_row = tpl_sheet_overdue.max_row
        if max_row > 1:
            tpl_sheet_overdue.delete_rows(2, max_row - 1)

        src_sheet_overdue = src_wb["数据源-逾期报表"]
        for row in src_sheet_overdue.iter_rows(min_row=2, values_only=True):
            tpl_sheet_overdue.append(row)

        # ---------- 更新“数据总表”、“吉享、吉享3、吉享5数据总表”、“鑫易融数据总表”、“吉海数据总表”、“吉米数据总表”、“通享融数据总表”、“惠享融数据总表”的A4单元格为当月最后一天 ----------
        last_day = calendar.monthrange(year, month)[1]
        target_date = date(year, month, last_day)
        tpl_wb["数据总表"]["A4"] = target_date
        tpl_wb["吉享、吉享3、吉享5数据总表"]["A4"] = target_date
        tpl_wb["鑫易融数据总表"]["A4"] = target_date
        tpl_wb["吉海数据总表"]["A4"] = target_date
        tpl_wb["吉米数据总表"]["A4"] = target_date
        tpl_wb["通享融数据总表"]["A4"] = target_date
        tpl_wb["惠享融数据总表"]["A4"] = target_date

        # ---------- 保存到月份文件夹下 ----------
        save_path = os.path.join(month_folder, f"ZJHY资产管理2025年{month}月报表_v202603.xlsx")
        try:
            tpl_wb.save(save_path)
            print(f"  已保存：{save_path}")
        except Exception as e:
            print(f"  保存失败：{e}")

        # 关闭工作簿（释放资源）
        src_wb.close()
        tpl_wb.close()

    print("所有月份处理完成。")

if __name__ == "__main__":
    daily_report_data_update()
