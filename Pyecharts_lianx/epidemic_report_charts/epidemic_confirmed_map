"""
国内疫情地图可视化展示
"""

import json
from pyecharts.charts import Map
from pyecharts.options import TitleOpts, VisualMapOpts, InitOpts

# 处理数据
# 读取文件
epidemic_info = open("D:\PythonProject\可视化案例数据\地图数据\疫情.txt", "r", encoding="UTF-8")
epidemic_data = epidemic_info.read()

# 选取各省份的数据
# 将 json 格式转换为 python 中的 dict 格式
epidemic_data_dict = json.loads(epidemic_data)

# 从 dict 中取出个省份的数据
province_data = epidemic_data_dict["areaTree"][0]["children"]

# 组装每个省份和确诊人数为元组，并将各个省份的数据封装至例表内
province_data_list = []
for province_info in province_data:
    province_name = province_info["name"]  # 提取省份名称
    province_confirmed = province_info["total"]["confirm"]  # 提取各省的确诊人数
    province_data_list.append((province_name + "省", province_confirmed))

# 创建地图对象
epidemic_map = Map(
    init_opts=InitOpts(
        width="800px",
        height="800px",
    )
)

# 添加数据
epidemic_map.add("全国疫情确诊人数情况",
                 province_data_list,
                 "china")

# 设置全局配置，定制分段视觉映射
epidemic_map.set_global_opts(
    title_opts=TitleOpts(
        is_show=True,
        pos_left="center",
        pos_bottom="1%"
    ),  # 配置标题
    visualmap_opts=VisualMapOpts(
        is_show=True,
        is_piecewise=True,
        pieces=(
            {"min": 1, "max": 99, "label": "1 - 99 人", "color": "#FFFACD"},
            {"min": 100, "max": 999, "label": "100 - 999 人", "color": "#FFFF00"},
            {"min": 1000, "max": 4999, "label": "1000 - 4999 人", "color": "#FF6A6A"},
            {"min": 5000, "max": 9999, "label": "5000 - 9999 人", "color": "#FF6347"},
            {"min": 10000, "max": 99999, "label": "10000 - 99999 人", "color": "#FF4500"},
            {"min": 100000, "label": "100000 人以上", "color": "#FF0000"}
        )
    )  # 配置视觉映射
)

# 调用 render 方法进行绘图
epidemic_map.render("全国疫情确诊人数情况.html")

# 关闭文件
epidemic_info.close()
