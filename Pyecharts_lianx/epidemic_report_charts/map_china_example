"""
基础可视化地图演示
"""

from pyecharts.charts import Map
from pyecharts.options import VisualMapOpts, InitOpts

# 准备地图对象
china_map = Map(
    init_opts=InitOpts(
        width="800px",
        height="600px"
    )
)

# 准备数据
map_data = [
    ("北京市", 99),
    ("上海市", 199),
    ("湖南省", 299),
    ("台湾省", 199),
    ("安徽省", 299),
    ("广东省", 399),
    ("湖北省", 599)
]

# 添加数据
china_map.add(
    "测试地图",
    map_data,
    "china",
    layout_center=["50%", "30%"]
)

# 设置全局配置项
china_map.set_global_opts(
    visualmap_opts=VisualMapOpts(
        is_show=True,
        is_piecewise=True,
        pieces=[
            {"min": 1, "max": 9, "label": "1 - 9 人", "color": "#CCFFFF"},
            {"min": 10, "max": 99, "label": "10 - 99 人", "color": "#FFFF99"},
            {"min": 100, "max": 499, "label": "100 - 499 人", "color": "#FF9966"},
            {"min": 500, "max": 999, "label": "500 - 999 人", "color": "#FF6666"},
            {"min": 1000, "max": 9999, "label": "1000 - 9999 人", "color": "#CC3333"},
            {"min": 10000, "label": "10000 人以上", "color": "#990033"}
        ]
    )
)

# 调用 render 方法，绘图
china_map.render()
